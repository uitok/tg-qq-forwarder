TG_API_ID=123456
TG_API_HASH=replace-with-your-api-hash

# NapCat OneBot HTTP API base URL. With the included local Docker mapping use 33100.
NAPCAT_API=http://127.0.0.1:33100
# Leave empty when NapCat has no access token.
NAPCAT_ACCESS_TOKEN=

# Optional. The session file is created under this name/path.
TG_SESSION=telegram_userbot
# Optional. Set these to a persistent mounted directory in Docker.
TG_CONFIG=config.json
TG_DOWNLOAD_DIR=downloads
TG_SESSION_DIR=data/sessions

# Web panel
PANEL_DB=data/panel.db
PANEL_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-8-characters
PANEL_CORS_ORIGINS=http://localhost:5173
PANEL_COOKIE_SECURE=false
